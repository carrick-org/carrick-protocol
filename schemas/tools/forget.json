{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/carrick-org/carrick-protocol/v0.9/schemas/tools/forget.json",
  "title": "Input of the `forget` tool",
  "description": "Retract a note. Nothing is deleted.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The note's id (path) or its uid."
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "reason"
  ]
}
