{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/carrick-org/carrick-protocol/v0.9/schemas/discovery.schema.json",
  "title": "Carrick discovery document",
  "description": "GET /.well-known/carrick (or the earlier /.well-known/lodestone). Required in Core (spec/3-owner-interface.md, section 3.12); Federation and Moving add fields.",
  "type": "object",
  "required": [
    "protocol",
    "base_url",
    "levels"
  ],
  "properties": {
    "protocol": {
      "enum": ["carrick/1", "lodestone/1"]
    },
    "owner": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        }
      },
      "description": "Only when the owner has at least one listed publication.",
      "required": [
        "display_name"
      ]
    },
    "base_url": {
      "type": "string",
      "pattern": "^https?://[^/]+$"
    },
    "levels": {
      "type": "array",
      "items": {
        "enum": [
          "core",
          "federation",
          "moving"
        ]
      },
      "contains": {
        "const": "core"
      }
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "mcp": {
          "type": "string"
        },
        "federation": {
          "type": "string"
        },
        "export": {
          "type": "string",
          "description": "Moving: where the owner downloads the memory as a git bundle."
        },
        "connections": {
          "type": "string",
          "description": "Moving: where the owner downloads the connections file."
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "mcp"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,47}$"
          },
          "title": {
            "type": "string"
          },
          "mcp": {
            "type": "string"
          },
          "release": {
            "type": "string"
          }
        }
      }
    },
    "keys": {
      "description": "Moving: public keys that sign this owner's moved record.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kid",
          "kty",
          "crv",
          "x"
        ],
        "properties": {
          "kid": {
            "type": "string"
          },
          "kty": {
            "const": "OKP"
          },
          "crv": {
            "const": "Ed25519"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    },
    "moved_from": {
      "description": "Moving: earlier base URLs of this owner, confirming a move here.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moved": {
      "$ref": "moved.schema.json#/$defs/moved"
    },
    "signature": {
      "type": "string"
    }
  },
  "dependentRequired": {
    "moved": [
      "signature"
    ]
  },
  "additionalProperties": true,
  "if": {
    "description": "No listed publication (none, or the field left out)...",
    "properties": {
      "publications": {
        "maxItems": 0
      }
    }
  },
  "then": {
    "description": "...means no owner name.",
    "not": {
      "required": [
        "owner"
      ]
    }
  }
}
