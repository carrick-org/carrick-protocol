{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getlodestone.net/protocol/0.9/schemas/connections.schema.json",
  "title": "Lodestone connections file",
  "description": "What can safely move of the owner's connections. Never holds a credential. See spec/5-moving.md (section 5.6).",
  "type": "object",
  "required": ["protocol", "owner", "peers_in", "peers_out"],
  "properties": {
    "protocol": {"const": "lodestone/1"},
    "owner": {"type": "string"},
    "peers_in": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "credential_sha256"],
        "properties": {
          "id": {"type": "string"},
          "person": {"type": "string"},
          "url": {"type": "string"},
          "owner": {"type": "string"},
          "credential_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "not": {"anyOf": [{"required": ["credential"]}, {"required": ["token"]}]}
      }
    },
    "peers_out": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "properties": {
          "url": {"type": "string"},
          "kind": {"enum": ["peer", "publication"]},
          "slug": {"type": "string"},
          "owner": {"type": "string"}
        },
        "not": {"anyOf": [{"required": ["credential"]}, {"required": ["token"]}]}
      }
    }
  }
}
